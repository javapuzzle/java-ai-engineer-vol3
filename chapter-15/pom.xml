<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail.agents</groupId>
    <artifactId>chapter-15</artifactId>
    <version>1.0.0</version>
    <name>chapter-15-multi-agent-orchestration-fundamentals</name>
    <description>
        Volume 3, Chapter 15 -- Multi-Agent Orchestration Fundamentals.
        Splits one unbounded agent into narrow-scope specialists (order,
        inventory, return) coordinated by an orchestrator that decides
        which specialists to call, in what order, and whether a later
        specialist is even worth calling given an earlier one's answer --
        the same single-responsibility principle Sarah already applies to
        ordinary Java classes.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
