<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail.agents</groupId>
    <artifactId>chapter-10</artifactId>
    <version>1.0.0</version>
    <name>chapter-10-self-planning-agents-and-reflection</name>
    <description>
        Volume 3, Chapter 10 -- Self-Planning Agents and Reflection Loops.
        Adds a self-critique step that checks a drafted action against
        the request it's meant to satisfy before committing to it,
        revising when the draft doesn't actually match, and honestly
        flagging for human review when neither candidate confidently
        does. This is the full implementation of the idea Volume 2
        Chapter 12 introduced by scenario only and explicitly deferred:
        "Agentic RAG... explicitly deferred to Semester 3."
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
