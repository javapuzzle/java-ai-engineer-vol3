<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail.agents</groupId>
    <artifactId>chapter-09</artifactId>
    <version>1.0.0</version>
    <name>chapter-09-chaining-routing-and-parallelization</name>
    <description>
        Volume 3, Chapter 9 -- Prompt Chaining, Routing, and
        Parallelization Patterns. Three workflow shapes that solve most
        real agent-shaped requests without a fully autonomous agent: a
        fixed sequence of steps (chaining), a single classify-then-
        dispatch decision (routing), and independent sub-tasks run
        concurrently and combined (parallelization, using real Java 21
        virtual threads).
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
