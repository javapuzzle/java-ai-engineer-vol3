<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail.agents</groupId>
    <artifactId>chapter-18</artifactId>
    <version>1.0.0</version>
    <name>chapter-18-guardrails-constraining-agent-behavior-safely</name>
    <description>
        Volume 3, Chapter 18 -- Guardrails: Constraining Agent Behavior
        Safely. RefundGuardrail enforces a hard limit outside any agent's
        own reasoning: two individually legitimate refund calls, each
        under any single-call cap, can still be blocked in combination
        once their cumulative total would exceed an order's real amount.
        The same "never trust the model to self-limit" lesson from
        volume1_2 Ch.18 and volume2_1 Ch.18, now applied to autonomous
        action instead of answers or retrieval.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
