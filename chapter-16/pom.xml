<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail.agents</groupId>
    <artifactId>chapter-16</artifactId>
    <version>1.0.0</version>
    <name>chapter-16-state-graphs-checkpointing-and-sagas</name>
    <description>
        Volume 3, Chapter 16 -- State Graphs, Checkpointing, and Sagas for
        Long-Running Agent Workflows. Models the return-and-replace
        workflow as an explicit state graph with persisted checkpoints (so
        a crashed workflow resumes instead of restarting) and saga-style
        compensating actions (so a failed later step undoes an already
        -completed earlier one instead of leaving the system inconsistent).
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
